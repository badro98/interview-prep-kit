{
  "name": "interview-prep-kit",
  "private": false,
  "version": "1.0.0",
  "description": "Local-first interview prep app — context-driven prep docs, flashcards, audio coaching, and advisor chat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/badro98/interview-prep-kit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,proxy -c blue,magenta \"vite\" \"node server/index.js\"",
    "dev:frontend": "vite",
    "demo:setup": "bash scripts/setup-demo.sh",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "idb": "^8.0.3",
    "marked": "^18.0.9",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}

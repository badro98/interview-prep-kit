# Required for coaching, advisor chat, audio scoring, and transcription fallback.
#
# Setup:
#   1. cp .env.example .env
#   2. Add your API key(s) below
#   3. npm run dev
#
# Keys stay server-side — never committed to git.
#
# Gemini (default provider — generous free tier):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by the proxy. Must support audio input for tone scoring.
GEMINI_MODEL=gemini-2.5-flash

# Optional — speaker labels on large interview recordings (>25 MB).
# AssemblyAI offers free credits for new accounts:
#   https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=

# Express proxy port (Vite proxies /api -> this). Optional.
PORT=3001

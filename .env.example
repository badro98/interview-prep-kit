# Optional — only needed for API mode (automated coaching + audio tone scoring).
# Paste mode (default) needs NONE of this.
#
# Setup:
#   1. cp .env.example .env
#   2. Paste your Gemini API key below (https://aistudio.google.com/apikey)
#   3. npm run dev:api   (runs vite + the Express proxy together)
#
# Keys stay server-side — never committed to git.

# Required for API mode — Google Gemini chat, coaching, audio scoring, transcription fallback
GEMINI_API_KEY=

# Model used by the proxy. Must support audio input for tone scoring.
GEMINI_MODEL=gemini-2.5-flash

# Optional — better speaker diarization for interview recordings >25MB (Prep Docs → Recording)
# Get a key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Express proxy port (Vite proxies /api -> this). Optional.
PORT=3001
